generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Anonymous rider identity. No email/password — secure opaque token only.
model Rider {
  id              String                @id @default(cuid())
  /// Hashed opaque token (never store raw). Used for auth.
  tokenHash       String                @unique
  /// Salted display name shown in community feed (e.g. "Rider-7F3A").
  displayName     String
  /// Optional home region label for local feeds.
  region          String?
  /// Reputation: increases with helpful reports / confirmations.
  reputation      Int                   @default(0)
  reportsCount    Int                   @default(0)
  votesCount      Int                   @default(0)
  createdAt       DateTime              @default(now())
  lastSeenAt      DateTime              @default(now())
  achievements    Achievement[]
  alertRecords    AlertRecord[]
  destinations    Destination[]
  favDestinations FavoriteDestination[]
  gpsPoints       GpsPoint[]
  hazardReports   HazardReport[]
  hazardVotes     HazardVote[]
  prefs           NotificationPref?
  riskRecords     RiskAssessment[]
  sosAlerts       SosAlert[]
  sosContacts     SosContact[]
  sessions        TrackingSession[]

  @@index([region])
}

/// Achievement badges earned by a rider (e.g. first_report, streak_7, top_contributor).
model Achievement {
  id       String   @id @default(cuid())
  riderId  String
  code     String
  earnedAt DateTime @default(now())
  rider    Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([riderId, code])
  @@index([riderId])
}

/// Trusted emergency contacts for the SOS feature.
model SosContact {
  id        String   @id @default(cuid())
  riderId   String
  name      String
  phone     String
  relation  String   @default("family")
  createdAt DateTime @default(now())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
}

/// An SOS alert triggered by a rider. Records location + timestamp + status.
model SosAlert {
  id          String    @id @default(cuid())
  riderId     String
  lat         Float
  lng         Float
  message     String?
  status      String    @default("active")
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
  rider       Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
}

/// Favorite/saved destinations for quick access.
model FavoriteDestination {
  id         String   @id @default(cuid())
  riderId    String
  label      String
  lat        Float
  lng        Float
  emoji      String   @default("📍")
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  rider      Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([riderId, label, lat, lng])
  @@index([riderId])
}

/// Pushed alerts for severe weather / hazards / risk changes.
model AlertRecord {
  id        String   @id @default(cuid())
  riderId   String
  type      String
  severity  String   @default("info")
  title     String
  body      String
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, read])
  @@index([createdAt])
}

/// Per-rider notification preferences.
model NotificationPref {
  riderId          String   @id
  severeWeather    Boolean  @default(true)
  newHazardNearby  Boolean  @default(true)
  riskEscalation   Boolean  @default(true)
  communityUpdates Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  rider            Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

/// A rider's travel/delivery session linking GPS trail to a route + risk.
model TrackingSession {
  id          String           @id @default(cuid())
  riderId     String
  status      String           @default("active")
  originLat   Float?
  originLng   Float?
  destLat     Float?
  destLng     Float?
  destLabel   String?
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  gpsPoints   GpsPoint[]
  riskRecords RiskAssessment[]
  rider       Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
}

/// GPS trail — separate from searched destinations (privacy: locations only).
model GpsPoint {
  id         String          @id @default(cuid())
  sessionId  String
  riderId    String
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  heading    Float?
  recordedAt DateTime        @default(now())
  rider      Rider           @relation(fields: [riderId], references: [id], onDelete: Cascade)
  session    TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([riderId])
}

/// Searched/selected destinations — explicitly chosen by rider (not GPS).
model Destination {
  id        String   @id @default(cuid())
  riderId   String
  label     String
  lat       Float
  lng       Float
  source    String   @default("search")
  createdAt DateTime @default(now())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
}

/// Community hazard reports. Lifecycle: active → disputed → resolved/expired.
model HazardReport {
  id           String       @id @default(cuid())
  reporterId   String
  type         String
  severity     String       @default("moderate")
  lat          Float
  lng          Float
  addressLabel String?
  description  String?
  imageUrl     String?
  /// Number of riders who confirmed still present.
  confirmCount Int          @default(0)
  /// Number of riders who disputed / say resolved.
  disputeCount Int          @default(0)
  status       String       @default("active")
  verified     Boolean      @default(false)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reporter     Rider        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  votes        HazardVote[]

  @@index([lat, lng])
  @@index([status])
  @@index([type])
}

/// Vote on a hazard: confirm (still there) or dispute (resolved).
model HazardVote {
  id        String       @id @default(cuid())
  hazardId  String
  riderId   String
  vote      String
  createdAt DateTime     @default(now())
  rider     Rider        @relation(fields: [riderId], references: [id], onDelete: Cascade)
  hazard    HazardReport @relation(fields: [hazardId], references: [id], onDelete: Cascade)

  @@unique([hazardId, riderId])
  @@index([hazardId])
}

/// Safe stops useful to riders: shelters, cafes, restrooms, charging.
model SafeStop {
  id        String   @id @default(cuid())
  name      String
  type      String
  lat       Float
  lng       Float
  address   String?
  hours     String?
  amenities String?
  rating    Float    @default(3.5)
  createdAt DateTime @default(now())

  @@index([lat, lng])
  @@index([type])
}

/// Cached weather snapshots to limit upstream calls.
model WeatherCache {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  data      String
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([lat, lng])
}

/// Persisted risk assessments — deterministic, source of truth.
model RiskAssessment {
  id             String           @id @default(cuid())
  riderId        String
  sessionId      String?
  score          Int
  level          String
  factors        String
  originLat      Float?
  originLng      Float?
  destLat        Float?
  destLng        Float?
  weatherSummary String?
  createdAt      DateTime         @default(now())
  session        TrackingSession? @relation(fields: [sessionId], references: [id])
  rider          Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([createdAt])
}
